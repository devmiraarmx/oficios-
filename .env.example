# Copia este archivo a .env y rellena los valores.
# En Railway, define estas mismas variables en el panel del servicio.

# Flask
FLASK_ENV=development
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Base de datos (Railway inyecta DATABASE_URL automáticamente en producción)
DATABASE_URL=postgresql://usuario:password@localhost:5432/oficios

# Twilio Verify (verificación de teléfono del cliente)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Stripe (compra de créditos) — o Conekta si se acepta OXXO
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (fotos de perfil)
CLOUDINARY_URL=

# Web Push (VAPID) — genera el par (base64url) una vez con:  flask vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:contacto@ejemplo.mx
